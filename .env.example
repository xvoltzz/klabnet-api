# Copy to .env for local development. Only read as a fallback (see
# app/config.py) — any env var already set (e.g. by compose.yml's
# `environment:` block) always wins, so real deployments don't need this
# file at all.

DB_PATH=./data/prefs.db
ADMIN_GROUP=klabnet-admin
PRESENCE_TTL=30
CORS_ORIGINS=https://user.klab.gg,https://staging.klab.gg

# Gitea — powers the in-app "report a bug / request a feature" panel.
# The token needs write:issue on GITEA_REPO. Without it the panel still
# lists existing issues (that endpoint is public) but can't file new ones.
GITEA_URL=https://git.klab.gg
GITEA_REPO=xvoltzz/klabnet-web
GITEA_TOKEN=

# Voice channels — a LiveKit server (compose.yml's "voice" profile). All
# three LIVEKIT_ values are needed; without them voice is off and the site
# hides it. See the README's Voice section.
# COMPOSE_PROFILES=voice
# LIVEKIT_URL=wss://voice.klab.gg
# LIVEKIT_API_KEY=klabnet
# LIVEKIT_API_SECRET=        # openssl rand -hex 32
